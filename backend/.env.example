DATABASE_URL=sqlite:///./fireflies.db
# Comma-separated list. Must include the frontend dev origin: `next dev` silently moves to 3001 (or 3002)
# when port 3000 is busy, and the browser then blocks API calls with a CORS error.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Optional regex for extra allowed origins, e.g. Vercel previews: https://.*\.vercel\.app
# CORS_ORIGIN_REGEX=
# Optional: when set, new meetings are summarised with Claude (falls back to the built-in heuristic on error)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Simulated processing time (seconds) between "uploaded" and "ready" so the Meeting Status flow is visible. 0 = instant.
PROCESSING_DELAY_SECONDS=4
# Demo hook: meetings whose title contains this text fail processing (rename + Retry then succeeds).
# PROCESSING_FAIL_PATTERN=
